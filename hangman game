import random

# 5 predefined Hangman words
words = ["python", "diamond", "rainbow", "elephant", "computer"]

# Hints for each word
hints = {
    "python": "A programming language",
    "diamond": "A very hard and valuable stone",
    "rainbow": "Appears in the sky after rain",
    "elephant": "The largest land animal",
    "computer": "An electronic machine used for computing"
}

score = 0

print("=" * 50)
print("          🎭 SECRET WORD HANGMAN 🎭")
print("=" * 50)

while True:

    # Choose a random word
    secret_word = random.choice(words)

    guessed_letters = []
    wrong_guesses = 0

    # Create hidden word
    display_word = ["_"] * len(secret_word)

    print("\nA new secret word has been selected!")
    print("Hint:", hints[secret_word])

    while wrong_guesses < 6 and "_" in display_word:

        print("\nWord:", " ".join(display_word))
        print("Wrong guesses:", wrong_guesses, "/ 6")

        if guessed_letters:
            print("Guessed letters:", " ".join(guessed_letters))

        guess = input("Guess a letter: ").lower().strip()

        # Check input
        if len(guess) != 1 or not guess.isalpha():
            print("⚠️ Enter only ONE alphabet letter.")
            continue

        # Check duplicate guess
        if guess in guessed_letters:
            print("🔄 You already guessed that letter!")
            continue

        guessed_letters.append(guess)

        # Correct guess
        if guess in secret_word:

            print("✅ Correct guess!")

            for i in range(len(secret_word)):
                if secret_word[i] == guess:
                    display_word[i] = guess

        # Wrong guess
        else:

            wrong_guesses += 1
            print("❌ Wrong guess!")

    # Game result
    if "_" not in display_word:

        print("\n🎉 YOU WON!")
        print("The secret word was:", secret_word)

        # More points for fewer mistakes
        points = (6 - wrong_guesses) * 10
        score += points

        print("⭐ Points earned:", points)

    else:

        print("\n😔 YOU LOST!")
        print("The secret word was:", secret_word)

    print("🏆 Total Score:", score)

    # Replay
    again = input("\nPlay Hangman again? (yes/no): ").lower()

    if again != "yes":
        break

print("\n" + "=" * 50)
print("🎭 FINAL HANGMAN SCORE:", score)
print("Thanks for playing!")
print("=" * 50)